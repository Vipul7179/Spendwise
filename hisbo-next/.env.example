# Supabase Configuration
# Replace these with your actual Supabase project URL and Anon/Publishable Key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Optional: Service Role Key for server-only admin actions (never prefix with NEXT_PUBLIC_)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only

# SEO canonical origin is fixed to https://www.hisbo.in in src/lib/seo.ts.

# GA4: manual tracking only, after explicit visitor consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-LCMEK1R5HY
# Enable ONLY after completing the GA4 stream privacy setup in docs/analytics.md.
NEXT_PUBLIC_GA_MANUAL_TRACKING_READY=false
NEXT_PUBLIC_GA_DEBUG=false


