# ====================================================================
# Hisbo Control — Environment Variables Template
# ====================================================================
# NEVER commit real credentials or .env.local to Git.
# Configure these variables in your deployment environment (Vercel) or local .env.local.
# ====================================================================

# 1. Supabase Public Access (Client-side & Auth session management)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# 2. Supabase Server-Only Service Role (Privileged Admin backend operations only)
# IMPORTANT: Never prefix with NEXT_PUBLIC_. Only accessible in server contexts.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-server-only

# 3. Application URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# In production: https://control.hisbo.in

# 4. Google Analytics 4 Data API (Server-side metrics extraction)
# Optional: Required when connecting live GA4 Data API for analytics reporting.
GA4_PROPERTY_ID=your-ga4-property-id
GA4_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# 5. Platform Monitoring Integration (Vercel API)
# Optional: Required when querying live deployment status and edge metrics.
VERCEL_ACCESS_TOKEN=your-vercel-personal-access-token
VERCEL_PROJECT_ID=your-vercel-project-id


# 6. Production Read-Only Reporting Database (Spendwise Production Pooler)
# Optional: Required ONLY if streaming registered user directory & metrics from production.
# Keep disabled until Migration 003_production_reporting_setup.sql is executed.
PROD_REPORTING_ENABLED=false
PROD_REPORTING_DATABASE_URL=postgresql://hisbo_readonly_reporter:<YOUR_SECURE_PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
